[Unit]
Description=Audio Recording Service
After=network.target sound.target

[Service]
Type=simple
User=audio
WorkingDirectory=/opt/yamnet-audio-monitor

ExecStart=/usr/bin/ffmpeg 
-f alsa 
-sample_rate 48000 
-format s16le 
-channels 1 
-i hw:1,0 
-af "highpass=f=80,lowpass=f=8000" 
-f segment 
-segment_time 300 
-strftime 1 
"/var/lib/yamnet-audio-monitor/audio/%Y-%m-%d-%H%M.wav"

Restart=always
RestartSec=10

[Install]
WantedBy=multi-user.target
